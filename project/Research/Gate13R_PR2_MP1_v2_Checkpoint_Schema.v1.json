{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate13r-pr2-mp1-pilot-checkpoint-v2-schema-v1",
  "title": "Gate 13R-PR2 MP1 v2 checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "checkpointKind", "savedAtUtc", "status", "startedAtUtc", "completedAtUtc",
    "completedBlockCount", "completedSampleCount", "expectedBlockCount", "expectedSampleCount",
    "currentGlobalProcessOrdinal", "currentBlockId", "lastCompletedGlobalProcessOrdinal", "lastCompletedBlockId",
    "failureClass", "failureStage", "failureMessage", "failureReceiptRelativePath", "failureReceiptSha256",
    "partialOutputManifestRelativePath", "partialOutputManifestSha256", "phaseACommitStartedAtUtc",
    "phaseACommittedAtUtc", "phaseACommitted", "rawDataComplete", "rawTreeSha256", "rawManifestRelativePath",
    "rawManifestSha256", "environmentEndSnapshotRelativePath", "environmentEndSnapshotSha256",
    "automaticRetryAuthorized", "automaticResumeAuthorized", "topUpAuthorized", "partialMergeAuthorized",
    "formalCampaign", "formalAnalysisAuthorized", "gate14RAuthorized"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "checkpointKind": {"const": "gate13r-pr2-mp1-pilot-checkpoint-v2"},
    "savedAtUtc": {"type": "string", "format": "date-time"},
    "status": {"enum": ["AUTHORIZED-NOT-STARTED", "MEASURED-ACQUISITION-RUNNING", "BLOCK-PROGRESS", "PHASE-A-COMMIT-IN-PROGRESS", "PILOT-RAW-DATA-COMPLETE / ANALYSIS-PENDING / IMMUTABLE", "FAILED-NO-AUTO-RETRY-NO-RESUME-NO-TOP-UP-NO-MERGE"]},
    "startedAtUtc": {"type": ["string", "null"]},
    "completedAtUtc": {"type": ["string", "null"]},
    "completedBlockCount": {"type": "integer", "minimum": 0, "maximum": 96},
    "completedSampleCount": {"type": "integer", "minimum": 0, "maximum": 384},
    "expectedBlockCount": {"const": 96},
    "expectedSampleCount": {"const": 384},
    "currentGlobalProcessOrdinal": {"type": "integer", "minimum": 0, "maximum": 96},
    "currentBlockId": {"type": ["string", "null"]},
    "lastCompletedGlobalProcessOrdinal": {"type": "integer", "minimum": 0, "maximum": 96},
    "lastCompletedBlockId": {"type": ["string", "null"]},
    "failureClass": {"type": ["string", "null"]},
    "failureStage": {"type": ["string", "null"]},
    "failureMessage": {"type": ["string", "null"]},
    "failureReceiptRelativePath": {"type": ["string", "null"]},
    "failureReceiptSha256": {"type": ["string", "null"]},
    "partialOutputManifestRelativePath": {"type": ["string", "null"]},
    "partialOutputManifestSha256": {"type": ["string", "null"]},
    "phaseACommitStartedAtUtc": {"type": ["string", "null"]},
    "phaseACommittedAtUtc": {"type": ["string", "null"]},
    "phaseACommitted": {"type": "boolean"},
    "rawDataComplete": {"type": "boolean"},
    "rawTreeSha256": {"type": ["string", "null"]},
    "rawManifestRelativePath": {"type": ["string", "null"]},
    "rawManifestSha256": {"type": ["string", "null"]},
    "environmentEndSnapshotRelativePath": {"type": ["string", "null"]},
    "environmentEndSnapshotSha256": {"type": ["string", "null"]},
    "automaticRetryAuthorized": {"const": false},
    "automaticResumeAuthorized": {"const": false},
    "topUpAuthorized": {"const": false},
    "partialMergeAuthorized": {"const": false},
    "formalCampaign": {"const": false},
    "formalAnalysisAuthorized": {"const": false},
    "gate14RAuthorized": {"const": false}
  }
}
