      "confirmatoryNullBoundary": "log1p contrast = 0"
    },
    {
      "domainId": "D5_AGENT_COUNT_SCALING",
      "axis": "log2(N)",
      "levels": [32, 64, 128],
      "mipe": "IDFF-minus-comparator slope difference per axis unit <= ln(0.90)",
      "confirmatoryNullBoundary": 0
    },
    {
      "domainId": "D6_CHANGE_FOOTPRINT_SCALING",
