    {
      "domainId": "D2_GRID_READ_WORK",
      "estimand": "geometric-mean grid-accessor-call ratio",
      "mipe": "ratio <= 0.90",
      "planningAlternativeOnModelScale": "log contrast = ln(0.90)",
      "confirmatoryNullBoundary": "ratio = 1"
    },
    {
      "domainId": "D3_DYNAMIC_ALLOCATION",
      "estimand": "ratio-like contrast on log1p(total managed allocation bytes) with mandatory raw-byte summaries",
      "mipe": "ratio on the 1+bytes scale <= 0.90",
      "planningAlternativeOnModelScale": "log1p contrast = ln(0.90)",
      "confirmatoryNullBoundary": "log1p contrast = 0"
    },
    {
      "domainId": "D4_PERSISTENT_STATE_BYTES",
      "estimand": "ratio-like contrast on log1p(max persistent-state bytes) with mandatory raw-byte summaries",
      "mipe": "ratio on the 1+bytes scale <= 0.90",
