      "confirmatoryNullBoundary": 0
    },
    {
      "domainId": "D7_GRID_SIZE_SCALING",
      "axis": "log2(G^2)",
      "levels": [64, 96, 128],
      "mipe": "IDFF-minus-comparator slope difference per log2 grid-cell-count unit <= ln(0.90)",
      "confirmatoryNullBoundary": 0
    }
